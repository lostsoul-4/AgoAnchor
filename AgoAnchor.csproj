<?xml version="1.0" encoding="utf-8"?>
<!--
  Compiled directly with the csc.exe that ships with .NET Framework 4.x.
  No .NET SDK, MSBuild or Visual Studio is required.
  Easiest path: run build.bat.
  If you do have MSBuild available, you can also run:
    msbuild AgoAnchor.csproj -p:Configuration=Release
-->
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AgoAnchor</RootNamespace>
    <AssemblyName>AgoAnchor</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <DefineConstants>TRACE</DefineConstants>
    <ApplicationIcon>src\res\app.ico</ApplicationIcon>
    <OutputPath>build\</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

